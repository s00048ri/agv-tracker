# Cloudflare Pages _headers (CLAUDE.md §9 Task 11).
# Observable Framework copies src/_headers to dist/_headers during `npm run
# build`. Cloudflare Pages reads it at the root of the output directory.
#
# Rules are applied top-to-bottom and paths support `*` / `:placeholder`.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=(), camera=(), microphone=()
  # Observable Framework runs reactive cells via new Function(...) at runtime,
  # so a strict CSP without 'unsafe-eval' / 'unsafe-inline' would disable the
  # dashboard entirely. Origin restriction via 'self' + frame-ancestors 'none'
  # + strict MIME handling keep the residual risk bounded.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: public, max-age=600

# Hashed assets from Observable Framework's build are content-addressed, so
# they can be cached effectively forever.
/_file/*
  Cache-Control: public, max-age=31536000, immutable

/_import/*
  Cache-Control: public, max-age=31536000, immutable

/_observablehq/*
  Cache-Control: public, max-age=31536000, immutable

/_npm/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons and static root-level assets.
/robots.txt
  Cache-Control: public, max-age=3600
